// Esquema Prisma de company-service (tenant: empresas + membresías).
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider = "prisma-client-js"
    output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyPlan {
  STARTER
  PRO
  BUSINESS
}

enum MembershipRole {
  OWNER
  MANAGER
  WORKER
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

model Company {
  id                   String              @id @default(uuid())
  name                 String
  taxId                String?
  email                String
  phone                String
  address              String
  city                 String
  country              String              @default("CO")
  logoUrl              String?
  plan                 CompanyPlan         @default(STARTER)
  subscriptionStatus   String
  stripeCustomerId     String?
  stripeSubscriptionId String?
  memberships          CompanyMembership[]
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  // Dos empresas no pueden compartir NIT dentro del mismo país (los formatos
  // de identificación tributaria no son comparables entre países, así que
  // no se hace único a nivel global). NULLs no colisionan entre sí en
  // Postgres, así que las empresas sin taxId no se ven afectadas.
  @@unique([country, taxId])
}

model CompanyMembership {
  id        String           @id @default(uuid())
  companyId String
  userId    String // cross-service ref a auth-service User, sin FK real
  role      MembershipRole
  status    MembershipStatus @default(INVITED)
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([companyId, userId])
  // Soporta la consulta "en qué empresas participa este usuario" (patrón de
  // acceso obvio para un modelo multi-tenant, aunque hoy no exista todavía
  // un endpoint que lo use) sin escanear toda la tabla.
  @@index([userId])
}
