NODE_ENV=development
PORT=3004

# PostgreSQL — company-service tiene su propia base de datos
DATABASE_URL=postgresql://company_user:company_pass@company-postgres:5432/company_db

# OpenTelemetry
OTEL_SERVICE_NAME=company-service
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# Secreto de verificación del access token emitido por auth-service.
# Debe ser BYTE-IDÉNTICO al JWT_ACCESS_SECRET de auth-service. Min 32 chars.
JWT_ACCESS_SECRET=

# Auth service — endpoint interno de lookup de usuario por email
AUTH_SERVICE_URL=http://auth-service:3001
AUTH_SERVICE_TIMEOUT=5000

# Notification service — envía el email de invitación a un miembro
NOTIFICATION_SERVICE_URL=http://notification-service:3003
NOTIFICATION_SERVICE_TIMEOUT=5000

# Secreto compartido con auth-service (header x-internal-api-key).
# Debe ser idéntico al INTERNAL_SERVICE_SECRET de auth-service. Min 32 chars.
INTERNAL_SERVICE_SECRET=

# Storage (S3-compatible, MinIO en dev) para el logo de la empresa
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=company-logos
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=http://localhost:9000/company-logos
