{
  "openapi": "3.0.0",
  "paths": {
    "/company/v1/metrics": {
      "get": {
        "operationId": "MetricsController_getMetrics_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["Metrics"]
      }
    },
    "/company/v1/companies": {
      "post": {
        "operationId": "CompanyController_create_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCompanyDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Empresa creada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos."
          },
          "401": {
            "description": "No autenticado."
          }
        },
        "summary": "Crear una empresa (el usuario autenticado queda como OWNER)",
        "tags": ["Companies"]
      }
    },
    "/company/v1/companies/{id}": {
      "get": {
        "operationId": "CompanyController_get_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la empresa",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Datos de la empresa.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado."
          },
          "404": {
            "description": "La empresa no existe o el usuario no es miembro activo de ella."
          }
        },
        "summary": "Obtener una empresa de la que el usuario es miembro",
        "tags": ["Companies"]
      }
    },
    "/company/v1/companies/{id}/logo": {
      "post": {
        "operationId": "CompanyController_uploadLogo_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la empresa",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Logo actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Formato de imagen no soportado."
          },
          "401": {
            "description": "No autenticado."
          },
          "403": {
            "description": "El usuario no tiene permisos para gestionar el logo de esta empresa."
          },
          "404": {
            "description": "La empresa no existe."
          }
        },
        "summary": "Subir/reemplazar el logo de la empresa",
        "tags": ["Companies"]
      }
    },
    "/company/v1/companies/{id}/workers": {
      "post": {
        "operationId": "CompanyController_registerWorker_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la empresa",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterWorkerDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Trabajador provisionado y membresía creada como ACTIVE.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos, o rol OWNER no permitido aquí."
          },
          "401": {
            "description": "No autenticado."
          },
          "403": {
            "description": "El solicitante no es OWNER/MANAGER de la empresa."
          },
          "404": {
            "description": "La empresa no existe."
          }
        },
        "summary": "Registrar (provisionar) un trabajador nuevo directamente en la empresa",
        "tags": ["Companies"]
      }
    },
    "/company/v1/companies/{id}/members": {
      "post": {
        "operationId": "CompanyMembershipController_invite_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la empresa",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteMemberDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitación creada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos."
          },
          "401": {
            "description": "No autenticado."
          },
          "403": {
            "description": "El solicitante no es OWNER/MANAGER de la empresa."
          },
          "404": {
            "description": "No existe un usuario con ese email."
          },
          "409": {
            "description": "Ese usuario ya es miembro de la empresa."
          }
        },
        "summary": "Invitar a un usuario ya registrado como miembro de la empresa",
        "tags": ["Company Members"]
      },
      "get": {
        "operationId": "CompanyMembershipController_list_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la empresa",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Miembros de la empresa.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MembershipResponseDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "No autenticado."
          },
          "404": {
            "description": "La empresa no existe o el usuario no es miembro activo de ella."
          }
        },
        "summary": "Listar los miembros de la empresa",
        "tags": ["Company Members"]
      }
    },
    "/company/v1/companies/{id}/members/{membershipId}": {
      "patch": {
        "operationId": "CompanyMembershipController_update_v1",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Id de la empresa",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "membershipId",
            "required": true,
            "in": "path",
            "description": "Id de la membresía",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMemberDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Miembro actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos."
          },
          "401": {
            "description": "No autenticado."
          },
          "403": {
            "description": "El solicitante no es OWNER/MANAGER de la empresa."
          },
          "404": {
            "description": "La membresía no existe en esta empresa."
          },
          "409": {
            "description": "La empresa debe conservar al menos un OWNER activo."
          }
        },
        "summary": "Cambiar el rol y/o el estado de un miembro",
        "tags": ["Company Members"]
      }
    }
  },
  "info": {
    "title": "Company Service API",
    "description": "Documentación del servicio Company Service",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Distribuidora El Sol S.A.S.",
            "description": "Nombre de la empresa"
          },
          "taxId": {
            "type": "string",
            "example": "900123456-7",
            "description": "NIT / identificación tributaria"
          },
          "email": {
            "type": "string",
            "example": "contacto@elsol.com",
            "description": "Email de contacto de la empresa"
          },
          "phone": {
            "type": "string",
            "example": "+57 3001234567",
            "description": "Teléfono de contacto de la empresa"
          },
          "address": {
            "type": "string",
            "example": "Calle 123 # 45-67",
            "description": "Dirección física de la empresa"
          },
          "city": {
            "type": "string",
            "example": "Bogotá",
            "description": "Ciudad donde opera la empresa"
          },
          "country": {
            "type": "string",
            "example": "CO",
            "description": "País donde opera la empresa (código ISO de 2 letras). Default: CO"
          }
        },
        "required": ["name", "email", "phone", "address", "city"]
      },
      "CompanyResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "7f1b0f2e-9d4e-4d2a-9d0f-9a1b2c3d4e5f"
          },
          "name": {
            "type": "string",
            "example": "Distribuidora El Sol S.A.S."
          },
          "taxId": {
            "type": "string",
            "example": "900123456-7"
          },
          "email": {
            "type": "string",
            "example": "contacto@elsol.com"
          },
          "phone": {
            "type": "string",
            "example": "+57 3001234567"
          },
          "address": {
            "type": "string",
            "example": "Calle 123 # 45-67"
          },
          "city": {
            "type": "string",
            "example": "Bogotá"
          },
          "country": {
            "type": "string",
            "example": "CO"
          },
          "logoUrl": {
            "type": "string",
            "example": "http://localhost:9000/company-logos/logos/c-1.webp"
          },
          "plan": {
            "type": "string",
            "enum": ["STARTER", "PRO", "BUSINESS"],
            "example": "STARTER"
          },
          "subscriptionStatus": {
            "type": "string",
            "example": "active"
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-01-15T10:00:00.000Z"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "address",
          "city",
          "country",
          "plan",
          "subscriptionStatus",
          "createdAt"
        ]
      },
      "RegisterWorkerDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "example": "Juana",
            "description": "Nombre del trabajador"
          },
          "lastName": {
            "type": "string",
            "example": "Pérez",
            "description": "Apellido del trabajador"
          },
          "contactEmail": {
            "type": "string",
            "example": "trabajador@example.com",
            "description": "Email de contacto donde se le enviarán las credenciales de acceso"
          },
          "role": {
            "type": "string",
            "enum": ["MANAGER", "WORKER"],
            "example": "WORKER"
          }
        },
        "required": ["firstName", "lastName", "contactEmail", "role"]
      },
      "MembershipResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "3c2b1a09-8f7e-6d5c-4b3a-2f1e0d9c8b7a"
          },
          "companyId": {
            "type": "string",
            "example": "7f1b0f2e-9d4e-4d2a-9d0f-9a1b2c3d4e5f"
          },
          "userId": {
            "type": "string",
            "description": "Id del usuario en auth-service"
          },
          "role": {
            "type": "string",
            "enum": ["OWNER", "MANAGER", "WORKER"]
          },
          "status": {
            "type": "string",
            "enum": ["INVITED", "ACTIVE", "SUSPENDED"]
          },
          "createdAt": {
            "format": "date-time",
            "type": "string",
            "example": "2026-01-15T10:00:00.000Z"
          }
        },
        "required": ["id", "companyId", "userId", "role", "status", "createdAt"]
      },
      "InviteMemberDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "trabajador@example.com",
            "description": "Email del usuario a invitar"
          },
          "role": {
            "type": "string",
            "enum": ["OWNER", "MANAGER", "WORKER"],
            "example": "WORKER"
          }
        },
        "required": ["email", "role"]
      },
      "UpdateMemberDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": ["OWNER", "MANAGER", "WORKER"]
          },
          "status": {
            "type": "string",
            "enum": ["INVITED", "ACTIVE", "SUSPENDED"]
          }
        }
      }
    }
  }
}
