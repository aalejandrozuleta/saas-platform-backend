{
  "openapi": "3.0.0",
  "paths": {
    "/auth/v1/metrics": {
      "get": {
        "operationId": "MetricsController_getMetrics_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["Metrics"]
      }
    },
    "/auth/v1/verify-email": {
      "post": {
        "operationId": "AuthController_verifyEmail_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email verificado correctamente"
          },
          "400": {
            "description": "Token inválido o expirado"
          }
        },
        "summary": "Activa la cuenta verificando el token enviado por email",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/resend-verification": {
      "post": {
        "operationId": "AuthController_resendVerification_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResendVerificationDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email de verificación enviado si la cuenta existe y no está verificada"
          },
          "409": {
            "description": "El email ya está verificado"
          }
        },
        "summary": "Reenvía el email de verificación (útil para usuarios pre-registro)",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/forgot-password": {
      "post": {
        "operationId": "AuthController_forgotPassword_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForgotPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Email de recuperación enviado si la cuenta existe"
          }
        },
        "summary": "Solicita un enlace de recuperación de contraseña por email",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/reset-password": {
      "post": {
        "operationId": "AuthController_resetPassword_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contraseña actualizada correctamente"
          },
          "400": {
            "description": "Token inválido o expirado"
          },
          "422": {
            "description": "La nueva contraseña no cumple los requisitos o es igual a la actual"
          }
        },
        "summary": "Completa la recuperación de contraseña con el token enviado por email",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/register": {
      "post": {
        "operationId": "AuthController_register_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Solicitud aceptada. Si el email no estaba registrado, se crea la cuenta y se envía un correo de verificación; si ya existía, la respuesta es idéntica pero no se realiza ninguna acción (evita enumeración de cuentas).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterUserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos de entrada inválidos (email mal formado, contraseña débil, etc.)."
          }
        },
        "summary": "Registrar usuario",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/login": {
      "post": {
        "operationId": "AuthController_login_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginUserDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login exitoso. Tokens enviados en cookies HttpOnly (path=/v1/auth).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos de entrada inválidos o fingerprint de dispositivo ausente."
          },
          "401": {
            "description": "Credenciales incorrectas (respuesta idéntica si el email no existe)."
          },
          "403": {
            "description": "Cuenta bloqueada por intentos fallidos (bloqueo progresivo), dispositivo no confiable o país no reconocido."
          }
        },
        "summary": "Autenticar usuario",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/login/verify-2fa": {
      "post": {
        "operationId": "AuthController_verifyLoginChallenge_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyLoginChallengeDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login completado. Tokens enviados en cookies HttpOnly (path=/v1/auth).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginUserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "No se proporcionó ni totpCode ni recoveryCode."
          },
          "401": {
            "description": "Challenge token inválido/expirado, código TOTP inválido o recovery code inválido/ya usado."
          }
        },
        "summary": "Resolver el challenge de login con TOTP o recovery code",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/complete-first-login": {
      "post": {
        "operationId": "AuthController_completeFirstLogin_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompleteFirstLoginDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["Auth"]
      }
    },
    "/auth/v1/refresh": {
      "post": {
        "operationId": "AuthController_refresh_v1",
        "parameters": [],
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["Auth"]
      }
    },
    "/auth/v1/logout": {
      "post": {
        "operationId": "AuthController_logout_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Sesión cerrada correctamente"
          },
          "401": {
            "description": "Token de sesión inválido o expirado"
          }
        },
        "summary": "Cerrar sesión actual",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/logout-all": {
      "post": {
        "operationId": "AuthController_logoutAll_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Todas las sesiones cerradas correctamente"
          },
          "401": {
            "description": "Token de sesión inválido o expirado"
          }
        },
        "summary": "Cerrar todas las sesiones activas",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/change-password": {
      "post": {
        "operationId": "AuthController_changePassword_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contraseña actualizada. Todas las sesiones previas quedan revocadas."
          },
          "401": {
            "description": "Contraseña actual incorrecta o usuario no autenticado."
          },
          "422": {
            "description": "La nueva contraseña es idéntica a la actual."
          }
        },
        "summary": "Cambiar contraseña del usuario autenticado",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/2fa/enable": {
      "post": {
        "operationId": "AuthController_enable2fa_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Enable2faDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Secreto TOTP generado. Escanea el QR con tu app autenticadora y confirma con /2fa/verify.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Enable2faResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Contraseña incorrecta."
          },
          "409": {
            "description": "2FA ya está habilitado para este usuario."
          }
        },
        "summary": "Iniciar activación de 2FA (TOTP)",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/2fa/verify": {
      "post": {
        "operationId": "AuthController_verify2fa_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Verify2faDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "2FA activado correctamente. Se devuelven los códigos de recuperación de un solo uso.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verify2faResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Código TOTP inválido o expirado."
          },
          "422": {
            "description": "El setup de 2FA no fue iniciado. Llama primero a /2fa/enable."
          }
        },
        "summary": "Confirmar código TOTP y activar 2FA",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/2fa/disable": {
      "post": {
        "operationId": "AuthController_disable2fa_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Disable2faDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "2FA desactivado correctamente. Secreto y códigos de recuperación eliminados."
          },
          "401": {
            "description": "Contraseña o código TOTP incorrecto."
          },
          "422": {
            "description": "2FA no está habilitado para este usuario."
          }
        },
        "summary": "Desactivar 2FA del usuario autenticado",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/2fa/recovery-codes/regenerate": {
      "post": {
        "operationId": "AuthController_regenerateRecoveryCodes_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegenerateRecoveryCodesDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Nuevo lote de recovery codes generado. El anterior queda invalidado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Verify2faResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Contraseña o código TOTP incorrecto."
          },
          "422": {
            "description": "2FA no está habilitado para este usuario."
          }
        },
        "summary": "Regenerar el lote de recovery codes de 2FA",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/trusted-countries": {
      "get": {
        "operationId": "AuthController_getTrustedCountries_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Lista de códigos de país ISO 3166-1 alpha-2.",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "success": true,
                    "data": {
                      "countries": ["CO", "US"]
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Listar países de confianza del usuario autenticado",
        "tags": ["Auth"]
      },
      "post": {
        "operationId": "AuthController_addTrustedCountry_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddTrustedCountryDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "País agregado correctamente."
          },
          "409": {
            "description": "El país ya está en la lista de confianza."
          },
          "422": {
            "description": "Se alcanzó el límite máximo de 2 países de confianza."
          }
        },
        "summary": "Agregar un país de confianza (máx. 2)",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/trusted-countries/{country}": {
      "delete": {
        "operationId": "AuthController_removeTrustedCountry_v1",
        "parameters": [
          {
            "name": "country",
            "required": true,
            "in": "path",
            "description": "Código ISO 3166-1 alpha-2",
            "schema": {
              "example": "CO",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "País eliminado correctamente."
          },
          "404": {
            "description": "El país no está en la lista de confianza."
          }
        },
        "summary": "Eliminar un país de la lista de confianza",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/sessions": {
      "get": {
        "operationId": "AuthController_getSessions_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Lista de sesiones activas. `isCurrent: true` marca la sesión actual.",
            "content": {
              "application/json": {
                "schema": {
                  "example": {
                    "success": true,
                    "data": {
                      "sessions": [
                        {
                          "id": "uuid",
                          "isCurrent": true,
                          "ipAddress": "203.0.113.1",
                          "country": "CO",
                          "startedAt": "2026-06-26T20:00:00.000Z",
                          "device": {
                            "name": null,
                            "os": null,
                            "browser": null,
                            "isTrusted": true,
                            "lastUsedAt": "2026-06-26T21:00:00.000Z"
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Listar sesiones activas del usuario autenticado",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/sessions/{sessionId}": {
      "delete": {
        "operationId": "AuthController_revokeSession_v1",
        "parameters": [
          {
            "name": "sessionId",
            "required": true,
            "in": "path",
            "description": "ID de la sesión a cerrar",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Sesión cerrada correctamente."
          },
          "404": {
            "description": "La sesión no existe o no pertenece al usuario."
          }
        },
        "summary": "Revocar una sesión activa por ID",
        "tags": ["Auth"]
      }
    },
    "/auth/v1/users/me/profile": {
      "post": {
        "operationId": "UserProfileController_create_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserProfileDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Perfil creado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos o no se aceptaron los consentimientos."
          },
          "401": {
            "description": "No autenticado."
          },
          "409": {
            "description": "El usuario ya tiene un perfil creado."
          }
        },
        "summary": "Crear el perfil del usuario autenticado",
        "tags": ["User Profile"]
      },
      "get": {
        "operationId": "UserProfileController_get_v1",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Perfil del usuario.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "No autenticado."
          },
          "404": {
            "description": "El usuario todavía no ha creado su perfil."
          }
        },
        "summary": "Obtener el perfil del usuario autenticado",
        "tags": ["User Profile"]
      },
      "patch": {
        "operationId": "UserProfileController_update_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserProfileDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil actualizado.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos inválidos."
          },
          "401": {
            "description": "No autenticado."
          },
          "404": {
            "description": "El usuario todavía no ha creado su perfil."
          }
        },
        "summary": "Actualizar (parcialmente) el perfil del usuario autenticado",
        "tags": ["User Profile"]
      }
    },
    "/auth/v1/users/me/profile/avatar": {
      "post": {
        "operationId": "UserProfileController_uploadAvatar_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Foto de perfil actualizada.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfileResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Formato de imagen no soportado."
          },
          "401": {
            "description": "No autenticado."
          },
          "404": {
            "description": "El usuario todavía no ha creado su perfil."
          }
        },
        "summary": "Subir/reemplazar la foto de perfil",
        "tags": ["User Profile"]
      }
    },
    "/auth/v1/users/lookup": {
      "get": {
        "operationId": "InternalUserController_lookup_v1",
        "parameters": [
          {
            "name": "email",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": ""
          }
        },
        "tags": ["Internal"]
      }
    },
    "/auth/v1/users/provision": {
      "post": {
        "operationId": "InternalUserController_provision_v1",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProvisionWorkerDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": ""
          }
        },
        "tags": ["Internal"]
      }
    }
  },
  "info": {
    "title": "Auth Service API",
    "description": "Documentación del servicio Auth Service",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "VerifyEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "a3f8e1b2c4d5e6f7a3f8e1b2c4d5e6f7a3f8e1b2c4d5e6f7a3f8e1b2c4d5e6f7",
            "description": "Token de verificación enviado al correo electrónico"
          }
        },
        "required": ["token"]
      },
      "ResendVerificationDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "usuario@ejemplo.com",
            "description": "Correo electrónico de la cuenta a verificar"
          }
        },
        "required": ["email"]
      },
      "ForgotPasswordDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "usuario@ejemplo.com",
            "description": "Correo electrónico de la cuenta a recuperar"
          }
        },
        "required": ["email"]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "a3f8e1b2c4d5e6f7a3f8e1b2c4d5e6f7a3f8e1b2c4d5e6f7a3f8e1b2c4d5e6f7",
            "description": "Token de recuperación enviado al correo electrónico"
          },
          "newPassword": {
            "type": "string",
            "example": "NewPass456@Secure",
            "description": "Nueva contraseña de la cuenta",
            "minLength": 12
          }
        },
        "required": ["token", "newPassword"]
      },
      "RegisterUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@email.com",
            "description": "Email del usuario"
          },
          "password": {
            "type": "string",
            "example": "PasswordSuperSeguro123",
            "description": "Contraseña del usuario",
            "minLength": 12
          }
        },
        "required": ["email", "password"]
      },
      "RegisterUserResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "uuid-del-usuario",
            "description": "ID del usuario creado"
          },
          "email": {
            "type": "string",
            "example": "user@email.com",
            "description": "Email del usuario"
          }
        },
        "required": ["id", "email"]
      },
      "LoginUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
